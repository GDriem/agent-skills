#!/usr/bin/env bash
# pr-batch: run pr-review or pr-ready on a batch of PRs, one headless harness session per PR.
# Universal fallback for the -all skills, and usable from cron or CI. See README.md and adapters/.
# Works with the bash 3.2 that ships with macOS: no `wait -n`, no associative arrays, no mapfile.

set -euo pipefail

PROG=$(basename "$0")
SELF=$0
src=$0
while [ -L "$src" ]; do
  link=$(readlink "$src")
  case "$link" in /*) src=$link ;; *) src=$(dirname "$src")/$link ;; esac
done
. "$(cd "$(dirname "$src")" && pwd -P)/lib/batch.sh"
SRC_ROOT=$(cd "$(dirname "$src")/.." && pwd -P)

# Size classes for pr-review (skills/pr-review-all/references/batch.md, Step 2b). Paths and counts only.
SIZE_JQ='{number, lines: (.additions + .deletions), files: .changedFiles,
  sensitive: ([.files[].path | ascii_downcase | select(test("auth|login|session|token|permission|role|acl|security|crypto|secret|credential|password|migration|schema|payment|invoice|\\.github/workflows/|dockerfile|helm|terraform|k8s|deploy"))] | length > 0)}
  | if .sensitive then "normal" elif .lines <= 20 and .files <= 3 then "trivial"
    elif .lines <= 100 and .files <= 8 then "small" else "normal" end'
GROUP_MAX=5

usage() {
  cat <<EOF
Usage: $PROG --harness claude|codex [options] <prs|all>

  <prs>                  PR numbers, comma- or space-separated (401,405 or 401 405); "all" or nothing
                         means every open, non-draft PR of the repository
  --harness H            claude or codex (copilot, gemini and cursor are not implemented yet)
  --skill S              pr-review (default) or pr-ready
  --repo owner/repo      default: the repository of the current directory
  --parallel N           sessions at a time, default 3; 1 runs them one after another
  --model M              model for the normal PR sessions
  --small-model M        model for the budget tier (trivial and small PRs, pr-review only); default:
                         haiku for claude, the configured model at low reasoning effort for codex
  --no-tiering           every PR runs as normal: full review, one session per PR, no grouping
  --dry-run              forwarded to every PR: nothing is written to GitHub
  --yes                  do not ask before a batch that posts (required when stdin is not a terminal)
  --lang L               forwarded as --lang=L
  --focus F              forwarded as --focus="F"
  --run-dir DIR          write reports and summary here (default: \$AGENT_SKILLS_RUNS or
                         ~/.agent-skills/runs, plus a timestamp)
  --retry-failed DIR     rerun only the PRs with verdict ERROR in DIR/summary.json, in DIR

Exit code: 0 if no PR ended in ERROR, 1 if some did, 2 for a usage or setup error.
EOF
}

# One contract line with no agent behind it (skipped before launch, or a session without a result line).
synth_line() { # <pr> <verdict> <error> <summary>
  jq -cn --arg skill "$PRB_SKILL" --arg repo "$PRB_REPO" --argjson pr "$1" --arg verdict "$2" \
    --arg error "$3" --arg summary "$4" \
    '{skill:$skill,repo:$repo,pr:$pr,head:null,verdict:$verdict,max_priority:null,
      findings:{blocking:0,suggestion:0,decision:0},pending:null,posted:false,review_url:null,
      report:null,summary:$summary,error:$error}'
}

# ---------------------------------------------------------------------------------------------------
# Internal mode: one unit, "<class>:<n>[,<n>…]". Called by xargs with the configuration in PRB_* variables.
# normal and small are one PR; trivial is a group of PRs reviewed in series by one budget session.
run_unit() {
  local unit=$1 class=${1%%:*} list=${1#*:} n state open=() line raw log prompt args i
  for n in ${list//,/ }; do
    local out="$PRB_WORK/line-$n.json"
    [ -f "$PRB_WORK/tier-$n" ] || echo "$class" > "$PRB_WORK/tier-$n"   # an escalation keeps the first class
    if ! state=$(gh pr view "$n" --repo "$PRB_REPO" --json state,isDraft 2>"$PRB_WORK/pr-$n.view.err"); then
      synth_line "$n" ERROR "$(last_line < "$PRB_WORK/pr-$n.view.err")" "PR could not be read." > "$out"
      continue
    fi
    case "$(jq -r 'if .state != "OPEN" then (.state | ascii_downcase) elif .isDraft then "draft" else "ok" end' <<<"$state")" in
      ok) open+=("$n") ;;
      closed) synth_line "$n" SKIPPED closed "Skipped: the PR is closed." > "$out" ;;
      merged) synth_line "$n" SKIPPED merged "Skipped: the PR is merged." > "$out" ;;
      *) synth_line "$n" SKIPPED draft "Skipped: the PR is a draft." > "$out" ;;
    esac
  done
  [ ${#open[@]} -gt 0 ] || return 0

  local model=$PRB_MODEL effort="" extra=""
  if [ "$class" != normal ]; then
    extra=" --light"
    model=$PRB_SMALL_MODEL
    if [ "$PRB_HARNESS" = claude ]; then model=${model:-haiku}; else effort=low; fi
  fi
  local tail="--auto --run-dir=$PRB_RUN_DIR$extra"
  [ "$PRB_DRY" = 1 ] && tail="$tail --dry-run"
  [ -n "$PRB_LANG" ] && tail="$tail --lang=$PRB_LANG"
  [ -n "$PRB_FOCUS" ] && tail="$tail --focus=\"${PRB_FOCUS//\"/\'}\""

  local key=${open[0]}
  raw="$PRB_WORK/unit-$key.$PRB_HARNESS.out"; log="$PRB_WORK/unit-$key.$PRB_HARNESS.log"
  if [ ${#open[@]} -eq 1 ]; then
    prompt="/$PRB_SKILL $PRB_REPO#$key $tail"
    [ "$PRB_HARNESS" = codex ] && prompt="\$$PRB_SKILL $PRB_REPO#$key $tail"
  else
    prompt="Read the file $SRC_ROOT/skills/$PRB_SKILL/SKILL.md once and follow it for each of these invocations, one after another:"
    for n in "${open[@]}"; do prompt="$prompt
$PRB_SKILL $PRB_REPO#$n $tail"; done
    prompt="$prompt
Finish one PR before starting the next, and never carry a finding or an assumption from one PR to another.
Nobody can answer questions in this session. Your final message must end with the result line of each PR, in the order above, one per line, with nothing after the last one."
  fi
  line=$(BATCH_MODEL=$model BATCH_EFFORT=$effort BATCH_LINES=${#open[@]} BATCH_ADD_DIRS="$PRB_RUN_DIR:$PRB_TMP" \
    BATCH_TOOLS='Bash(gh *),Bash(git *),Bash(jq *),Bash(mkdir *),Bash(date *),Bash(printenv *),Bash(mktemp *),Bash(rm *),Read,Write,Glob,Grep' \
    headless_run "$PRB_HARNESS" "$prompt" "$raw" "$log")

  # Each PR takes the result line whose "pr" is its number, wherever it is among the trailing lines.
  for n in "${open[@]}"; do
    if l=$(printf '%s\n' "$line" | jq -cR --argjson n "$n" 'fromjson? | select(type == "object" and .pr == $n)' 2>/dev/null | last_line) && [ -n "$l" ]; then
      printf '%s\n' "$l" > "$PRB_WORK/line-$n.json"
    else
      synth_line "$n" ERROR "no result line (session log: $log)" "The session ended without a result line." > "$PRB_WORK/line-$n.json"
    fi
  done
}

if [ "${1:-}" = "--one" ]; then
  run_unit "$2"
  exit 0
fi

# ---------------------------------------------------------------------------------------------------
# Arguments

harness="" skill="" repo="" parallel=3 model="" small_model="" tiering=1 dry=0 yes=0 lang="" focus="" run_dir="" retry=""
tokens=()
while [ $# -gt 0 ]; do
  case "$1" in
    --harness) harness=${2:-}; shift 2 ;;
    --harness=*) harness=${1#*=}; shift ;;
    --skill) skill=${2:-}; shift 2 ;;
    --skill=*) skill=${1#*=}; shift ;;
    --repo) repo=${2:-}; shift 2 ;;
    --repo=*) repo=${1#*=}; shift ;;
    --parallel) parallel=${2:-}; shift 2 ;;
    --parallel=*) parallel=${1#*=}; shift ;;
    --model) model=${2:-}; shift 2 ;;
    --model=*) model=${1#*=}; shift ;;
    --small-model) small_model=${2:-}; shift 2 ;;
    --small-model=*) small_model=${1#*=}; shift ;;
    --no-tiering) tiering=0; shift ;;
    --lang) lang=${2:-}; shift 2 ;;
    --lang=*) lang=${1#*=}; shift ;;
    --focus) focus=${2:-}; shift 2 ;;
    --focus=*) focus=${1#*=}; shift ;;
    --run-dir) run_dir=${2:-}; shift 2 ;;
    --run-dir=*) run_dir=${1#*=}; shift ;;
    --retry-failed) retry=${2:-}; shift 2 ;;
    --retry-failed=*) retry=${1#*=}; shift ;;
    --dry-run) dry=1; shift ;;
    --yes) yes=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1 (see --help)" ;;
    *) tokens+=("$1"); shift ;;
  esac
done

check_harness "$harness"
check_parallel "$parallel"
check_bins gh jq awk "$harness"

# Retry: PRs, run dir, repo and skill come from the previous summary unless given.
if [ -n "$retry" ]; then
  [ -f "$retry/summary.json" ] || die "no summary.json in $retry"
  [ ${#tokens[@]} -eq 0 ] || die "--retry-failed takes no PR numbers"
  run_dir=$retry
  [ -n "$repo" ] || repo=$(jq -r 'map(.repo) | first // empty' "$retry/summary.json")
  [ -n "$skill" ] || skill=$(jq -r 'map(.skill) | first // empty' "$retry/summary.json")
  tokens=($(jq -r '.[] | select(.verdict == "ERROR") | .pr' "$retry/summary.json"))
  if [ ${#tokens[@]} -eq 0 ]; then
    echo "No PR with verdict ERROR in $retry/summary.json; nothing to retry."
    exit 0
  fi
fi

skill=${skill:-pr-review}
case "$skill" in pr-review|pr-ready) ;; *) die "--skill must be pr-review or pr-ready" ;; esac
[ "$skill" = pr-review ] || tiering=0

if [ -z "$repo" ]; then
  repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) ||
    die "not inside a clone with a GitHub remote; pass --repo owner/repo"
fi

# PR list: explicit numbers (validated, deduplicated, in the given order) or every open, non-draft PR.
prs=()
list_all=0
if [ ${#tokens[@]} -eq 0 ]; then list_all=1; fi
for t in ${tokens[@]+"${tokens[@]}"}; do
  for n in ${t//,/ }; do
    n=${n#\#}
    [ "$n" = all ] && { list_all=1; continue; }
    case "$n" in ''|*[!0-9]*) die "invalid PR number: $n" ;; esac
    [ "$n" -gt 0 ] || die "invalid PR number: $n"
    case " ${prs[*]-} " in *" $n "*) ;; *) prs+=("$n") ;; esac
  done
done
if [ "$list_all" = 1 ]; then
  [ ${#prs[@]} -eq 0 ] || die "give PR numbers or 'all', not both"
  prs=($(gh pr list --repo "$repo" --state open --limit 1000 --json number,isDraft \
    --jq '.[] | select(.isDraft | not) | .number' | sort -n))
  [ ${#prs[@]} -lt 1000 ] || echo "warning: 1000 PRs listed; the list may be truncated" >&2
fi
if [ ${#prs[@]} -eq 0 ]; then
  echo "No open, non-draft PRs in $repo."
  exit 0
fi

[ -n "$run_dir" ] || run_dir=$(default_run_dir)
run_dir=$(abs_dir "$run_dir")

# Units: one per normal or small PR; trivial PRs in groups of up to GROUP_MAX (a lone one runs as small).
units=() trivial=() classes=""
for n in "${prs[@]}"; do
  class=normal
  if [ "$tiering" = 1 ]; then
    class=$(gh pr view "$n" --repo "$repo" --json additions,deletions,changedFiles,files --jq "$SIZE_JQ" 2>/dev/null) ||
      class=normal
  fi
  classes="$classes #$n:$class"
  if [ "$class" = trivial ]; then trivial+=("$n"); else units+=("$class:$n"); fi
done
i=0
while [ $i -lt ${#trivial[@]} ]; do
  group=$(printf '%s\n' "${trivial[@]:$i:$GROUP_MAX}" | paste -sd, -)
  case "$group" in *,*) units+=("trivial:$group") ;; *) units+=("small:$group") ;; esac
  i=$((i + GROUP_MAX))
done

echo "$PROG: $skill on ${#prs[@]} PR(s) of $repo with $harness: ${prs[*]}"
echo "  parallel $parallel, model ${model:-harness default}, run dir $run_dir$([ "$dry" = 1 ] && echo ', dry run')"
if [ "$tiering" = 1 ]; then
  echo "  tiers:$classes; budget model ${small_model:-$([ "$harness" = claude ] && echo haiku || echo 'default at low effort')}"
fi

if [ "$dry" = 0 ] && [ "$yes" = 0 ]; then
  if [ -t 0 ]; then
    printf 'Every PR session runs with --auto and will post to GitHub. Continue? [y/N] '
    read -r answer
    case "$answer" in y|Y|yes|YES) ;; *) echo "Cancelled."; exit 0 ;; esac
  else
    die "a batch that posts needs --yes (or --dry-run) when stdin is not a terminal"
  fi
fi

# ---------------------------------------------------------------------------------------------------
# Run

tmp_root=${TMPDIR:-/tmp}
work=$(mktemp -d "${tmp_root%/}/pr-batch.XXXXXX")
export PRB_HARNESS=$harness PRB_SKILL=$skill PRB_REPO=$repo PRB_RUN_DIR=$run_dir PRB_WORK=$work \
  PRB_MODEL=$model PRB_SMALL_MODEL=$small_model PRB_DRY=$dry PRB_LANG=$lang PRB_FOCUS=$focus PRB_TMP=$tmp_root

printf '%s\n' "${units[@]}" | xargs -P "$parallel" -I{} "$SELF" --one {} || true

# Escalations: a light run that asked for a full review gets one, once (a full run cannot escalate).
escalated=()
for n in "${prs[@]}"; do
  [ -s "$work/line-$n.json" ] && jq -e '.escalate == true' "$work/line-$n.json" >/dev/null 2>&1 || continue
  cp "$work/line-$n.json" "$work/light-$n.json"
  escalated+=("$n")
done
if [ ${#escalated[@]} -gt 0 ]; then
  echo "  escalating to a full review: ${escalated[*]}"
  printf 'normal:%s\n' "${escalated[@]}" | xargs -P "$parallel" -I{} "$SELF" --one {} || true
fi

new="$work/new.json"
for n in "${prs[@]}"; do
  tier=$(cat "$work/tier-$n" 2>/dev/null || echo normal)
  esc=false
  [ -f "$work/light-$n.json" ] && esc=true
  if [ -s "$work/line-$n.json" ]; then cat "$work/line-$n.json"
  else synth_line "$n" ERROR "the PR session did not run" "No result."; fi |
    jq -c --arg tier "$tier" --argjson esc "$esc" \
      --arg reason "$(jq -r '.escalate_reason // empty' "$work/light-$n.json" 2>/dev/null)" \
      '. + {tier: $tier, escalated: $esc} + (if $esc then {escalate_reason: $reason} else {} end)'
done | jq -s '.' > "$new"

summary_json="$run_dir/summary.json"
if [ -n "$retry" ]; then
  jq --slurpfile new "$new" \
    'map(. as $old | (first($new[0][] | select(.pr == $old.pr)) // $old))' \
    "$summary_json" > "$work/merged.json"
  mv "$work/merged.json" "$summary_json"
else
  mv "$new" "$summary_json"
fi

# ---------------------------------------------------------------------------------------------------
# Summary

flags="--harness $harness --skill $skill --parallel $parallel"
[ -n "$model" ] && flags="$flags --model $model"
[ -n "$small_model" ] && flags="$flags --small-model $small_model"
[ "$tiering" = 0 ] && [ "$skill" = pr-review ] && flags="$flags --no-tiering"
[ "$dry" = 1 ] && flags="$flags --dry-run"
[ -n "$lang" ] && flags="$flags --lang $lang"
[ -n "$focus" ] && flags="$flags --focus \"$focus\""

table=$(jq -r --arg skill "$skill" '
  def cell: tostring | gsub("\\|"; "\\|") | gsub("\n"; " ");
  def opt: if . == null then "—" else . end;
  (if $skill == "pr-ready"
     then "| PR | Tier | Verdict | Max priority | Blocking / Suggestion / Decision | Pending | Posted | Summary | Report |\n|---|---|---|---|---|---|---|---|---|"
     else "| PR | Tier | Verdict | Max priority | Blocking / Suggestion / Decision | Posted | Summary | Report |\n|---|---|---|---|---|---|---|---|" end),
  (.[] | "| #\(.pr) | \(.tier // "normal")\(if .escalated then " → normal" else "" end) | \(.verdict) | \(.max_priority | opt) | \(.findings.blocking) / \(.findings.suggestion) / \(.findings.decision) |"
     + (if $skill == "pr-ready" then " \(.pending | opt) |" else "" end)
     + " \(.posted) | \(.summary | opt | cell) | \(.report | opt) |")
' "$summary_json")

problems=$(jq -r '.[] | select(.verdict == "ERROR" or .verdict == "SKIPPED") | "- #\(.pr) \(.verdict): \(.error)"' "$summary_json")
escalations=$(jq -r '.[] | select(.escalated) | "- #\(.pr) (\(.tier) → normal): \(.escalate_reason)"' "$summary_json")
failed=$(jq -r '[.[] | select(.verdict == "ERROR") | .pr] | map(tostring) | join(",")' "$summary_json")

summary_md="$run_dir/summary.md"
{
  echo "# $skill batch: $repo"
  echo
  echo "- Date: $(date '+%Y-%m-%d %H:%M')"
  echo "- Flags: $flags"
  echo "- Run directory: $run_dir"
  echo
  echo "$table"
  if [ -n "$escalations" ]; then
    echo; echo "## Escalated to a full review"; echo; echo "$escalations"
  fi
  if [ -n "$problems" ]; then
    echo; echo "## Errors and skipped"; echo; echo "$problems"
  fi
  if [ -n "$failed" ]; then
    echo; echo "Retry the failed PRs:"; echo
    echo '```bash'
    echo "$SELF $flags --retry-failed $run_dir"
    echo '```'
  fi
  if [ "$skill" = pr-ready ]; then
    jq -r '.[] | select(.verdict == "READY") | "\(.pr)|\(.report // "")"' "$summary_json" |
    while IFS= read -r row; do
      n=${row%%|*} report=${row#*|}
      echo; echo "## #$n approval comment"; echo
      if [ -n "$report" ] && [ -f "$report" ] && grep -q '<!-- approval:start -->' "$report"; then
        sed -n '/<!-- approval:start -->/,/<!-- approval:end -->/p' "$report" | sed '1d;$d'
      else
        echo "Approval block not found in the report: ${report:-no report}"
      fi
    done
  fi
} > "$summary_md"

echo
echo "$table"
[ -z "$problems" ] || { echo; echo "$problems"; }
[ -z "$failed" ] || { echo; echo "Retry: $SELF $flags --retry-failed $run_dir"; }
echo
echo "Summary: $summary_md"
echo "Session logs: $work"

batch_skill="$skill-all"
jq -c --arg skill "$batch_skill" --arg repo "$repo" --arg run_dir "$run_dir" --argjson dry "$([ "$dry" = 1 ] && echo true || echo false)" \
  --arg sj "$summary_json" --arg sm "$summary_md" '
  (if $skill == "pr-ready-all" then ["READY","NOT_READY","ERROR","SKIPPED"]
   else ["REQUEST_CHANGES","COMMENT","ERROR","SKIPPED"] end) as $verdicts
  | . as $lines
  | {skill:$skill, repo:$repo, run_dir:$run_dir, total:length,
     counts:(reduce $verdicts[] as $v ({}; .[$v] = ([$lines[] | select(.verdict == $v)] | length))),
     failed:[.[] | select(.verdict == "ERROR") | .pr], dry_run:$dry, summary_json:$sj, summary_md:$sm}
' "$summary_json"

[ -z "$failed" ]
